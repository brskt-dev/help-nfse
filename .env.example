# Configuração de exemplo para execução local (docker compose). NÃO contém segredos reais.
# Copie para .env e troque todas as senhas. O arquivo .env não é versionado.

# PostgreSQL local
POSTGRES_PASSWORD=troque-senha-postgres
DB_MIGRATOR_PASSWORD=troque-senha-migrator
DB_APP_PASSWORD=troque-senha-app
# Porta do PostgreSQL exposta só em 127.0.0.1 (útil para rodar a API fora do Docker)
DB_PORTA_LOCAL=5433

# Acesso inicial (o administrador é criado só se ainda não existir nenhum usuário)
ADMIN_EMAIL=admin@exemplo.local
ADMIN_PASSWORD=troque-esta-senha-com-10+-caracteres

# Aplicação
PORTA=8080
# Carrega dados fictícios de demonstração em banco vazio
DEMO_DADOS=true
# Permite que o cenário "Interromper o worker" encerre o processo de verdade (o Docker o reinicia)
SIMULACAO_INTERROMPER_WORKER=true

# ---------------------------------------------------------------------------------------------
# Na VPS (deploy/compose.yml), as variáveis do app vão no secret APP_ENV do repositório, por exemplo:
#   Admin__Email=...
#   Admin__Senha=...
#   Demo__CarregarDados=false
# As connection strings do banco são fornecidas pela infraestrutura.
#
# Certificado A1 (etapa de homologação, ainda NÃO utilizado): nunca versionar o arquivo nem a senha.
#   Certificado__CaminhoArquivo=/run/secrets/certificado.pfx   (arquivo montado no container)
#   Certificado__ConteudoBase64=...                             (alternativa: conteúdo em secret)
#   Certificado__Senha=...                                      (ou Certificado__CaminhoArquivoSenha)
